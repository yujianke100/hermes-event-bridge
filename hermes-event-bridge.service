[Unit]
Description=Hermes Event Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hermes-event-bridge
# 部署时：把文件放到 /etc/systemd/system/ 后，把下面的 --token 换成你的真实 token，
# 或者用 systemd 环境变量注入（EnvironmentFile=）。
ExecStart=/opt/hermes-event-bridge/venv/bin/python /opt/hermes-event-bridge/bridge.py --host 0.0.0.0 --port 8788 --token CHANGE_ME
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target